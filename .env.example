# PlaceGuard Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://placeguard:placeguard@localhost:5432/placeguard
DATABASE_ECHO=false

# ============================================================================
# LLM PROVIDER
# ============================================================================
# Options: gemini | openai | claude
LLM_PROVIDER=gemini

# Gemini Configuration (Google AI)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT=30

# OpenAI Configuration (for future use)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Claude Configuration (for future use)
# CLAUDE_API_KEY=your_claude_api_key_here
# CLAUDE_MODEL=claude-3-haiku-20240307

# ============================================================================
# API / SECURITY
# ============================================================================
JWT_SECRET=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# ============================================================================
# APPLICATION
# ============================================================================
DEBUG=false
LOG_LEVEL=INFO
